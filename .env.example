# =====================================================================
#  Camadas — configuração. Copie para .env e preencha:  cp .env.example .env
# =====================================================================

# ---------- Ligação à MariaDB externa ----------
# MariaDB no próprio servidor (fora do Docker): use host.docker.internal
# MariaDB noutro servidor: o IP ou nome desse servidor
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=camadas
DB_USER=camadas
DB_PASSWORD=mude-esta-password
# Em alternativa à password em texto: caminho para um ficheiro (Docker secrets)
# DB_PASSWORD_FILE=/run/secrets/db_password

# Prefixo das tabelas (útil se partilhar a base de dados com outras aplicações)
DB_TABLE_PREFIX=camadas_
# Ligação cifrada à MariaDB: false | true | skip-verify
DB_SSL=false
# Certificado da autoridade (CA) quando DB_SSL=true e o certificado não é público
# DB_SSL_CA=/app/certs/ca.pem
DB_CONNECTION_LIMIT=10

# ---------- Primeiro administrador ----------
# Criado no primeiro arranque se ainda não existir nenhum administrador.
# Depois de entrar, mude a password em "Perfil e password" e pode apagar estas linhas.
ADMIN_EMAIL=admin@seudominio.pt
ADMIN_PASSWORD=mude-me-ja-123
ADMIN_NAME=Administrador

# ---------- Contas ----------
# true = qualquer pessoa pode criar conta no ecrã de entrada
# false = só o administrador cria contas (menu "Gerir utilizadores")
ALLOW_REGISTRATION=false
# Novas contas recebem o diagrama de exemplo (loja online com 4 níveis)
EXAMPLE_FOR_NEW_USERS=true
# Duração da sessão (dias)
SESSION_DAYS=30

# ---------- Rede / web ----------
APP_NAME=Camadas
# Porta no servidor e endereço onde fica à escuta (127.0.0.1 = só via proxy local)
HOST_PORT=3000
BIND_ADDRESS=127.0.0.1
# Está atrás de um proxy (nginx, Caddy, Traefik)? Mantenha true.
TRUST_PROXY=true
# Cookie só por HTTPS: auto (deteta) | true | false
COOKIE_SECURE=auto
# Domínio para o Caddy (só com --profile https)
DOMAIN=diagramas.seudominio.pt
